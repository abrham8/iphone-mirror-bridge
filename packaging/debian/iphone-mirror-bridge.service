[Unit]
Description=iPhone Mirror Bridge (Bluetooth touchpad/mouse for iPhone)
Documentation=https://github.com/abrham8/iphone-mirror-bridge
After=bluetooth.service
Requires=bluetooth.service

[Service]
Type=simple
EnvironmentFile=-/etc/iphone-mirror-bridge/bridge.conf
ExecStart=/usr/bin/iphone-mirror-bridge $BRIDGE_ARGS
# Restart after adapter resets, resume from suspend, or input devices reappearing.
Restart=always
RestartSec=5
# Exit code 3 = another copy is already running.
RestartPreventExitStatus=3
RuntimeDirectory=iphone-mirror-bridge
# Settings changed in the desktop app: /var/lib/iphone-mirror-bridge/settings.json
StateDirectory=iphone-mirror-bridge
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
