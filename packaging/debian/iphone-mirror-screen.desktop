[Desktop Entry]
Type=Application
Name=iPhone Screen Mirroring
GenericName=AirPlay Receiver
Comment=Show your iPhone screen on this computer (click again to stop)
Exec=iphone-mirror-screen
Icon=iphone-mirror-bridge
Terminal=false
Categories=Utility;
Keywords=iPhone;AirPlay;mirror;screen;uxplay;
Actions=Start;Stop;AllowFirewall;

[Desktop Action Start]
Name=Start
Exec=iphone-mirror-screen --start

[Desktop Action Stop]
Name=Stop
Exec=iphone-mirror-screen --stop

[Desktop Action AllowFirewall]
Name=Allow through the firewall
Exec=iphone-mirror-screen --allow-firewall
